# ==============================================================================
# ORIGEMDEV - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your Supabase credentials.
# Note: In Vite, variables exposed to the client MUST start with 'VITE_'.

# Supabase API Configuration
# Your project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for client-side usage with RLS)
VITE_SUPABASE_ANON_KEY=your-anon-public-jwt-key
